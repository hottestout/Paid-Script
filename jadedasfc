-- Helper functions
local function isBloodObject(obj)
	if not obj or not obj.Name then return false end
	local name = string.lower(obj.Name)
	return name:find("blood") or name:find("gore") or name:find("splatter") or name:find("bleed")
end

local function handleBloodObject(obj)
	if not isBloodObject(obj) then return end

	if obj:IsA("ParticleEmitter") then
		if not bloodOriginalStates[obj] then
			bloodOriginalStates[obj] = { Rate = obj.Rate, Enabled = obj.Enabled }
		end
		local baseRate = bloodOriginalStates[obj].Rate
		obj.Rate = baseRate * (currentBloodIntensity / 100)
		obj.Enabled = (currentBloodIntensity > 0)
	elseif obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("BasePart") then
		if not bloodOriginalStates[obj] then
			bloodOriginalStates[obj] = { Transparency = obj.Transparency }
		end
		if currentBloodIntensity == 0 then
			obj.Transparency = 1
		else
			local baseTrans = bloodOriginalStates[obj].Transparency
			obj.Transparency = baseTrans + ((1 - baseTrans) * (1 - (currentBloodIntensity / 100)))
		end
	end
end

local function restoreAllBlood()
	for obj, state in pairs(bloodOriginalStates) do
		if obj and obj.Parent then
			if obj:IsA("ParticleEmitter") then
				obj.Rate = state.Rate
				obj.Enabled = state.Enabled
			elseif obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("BasePart") then
				obj.Transparency = state.Transparency
			end
		end
	end
	table.clear(bloodOriginalStates)
end

local function updateAllBlood()
	for _, desc in ipairs(workspace:GetDescendants()) do
		handleBloodObject(desc)
	end
end

local function getTargetPart(character)
	if not character then return nil end
	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Head")
end

local function getClosestPlayerToCursor()
	local closestPlayer = nil
	local shortestDistance = math.huge
	local mousePos = UserInputService:GetMouseLocation()

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
			local targetPart = getTargetPart(plr.Character)

			if humanoid and humanoid.Health > 0 and targetPart then
				local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
				if onScreen then
					local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
					if distance < shortestDistance then
						shortestDistance = distance
						closestPlayer = plr
					end
				end
			end
		end
	end
	return closestPlayer
end

local function resetHitbox(plr)
	if plr and plr.Character then
		local targetPart = getTargetPart(plr.Character)
		if targetPart and originalPartStates[targetPart] then
			local state = originalPartStates[targetPart]
			targetPart.Size = state.Size
			targetPart.Transparency = state.Transparency
			targetPart.Color = state.Color
			targetPart.Material = state.Material
			targetPart.CanCollide = state.CanCollide
			originalPartStates[targetPart] = nil
		end
	end
end

local function resetAllHitboxes()
	for targetPart, state in pairs(originalPartStates) do
		if targetPart and targetPart.Parent then
			targetPart.Size = state.Size
			targetPart.Transparency = state.Transparency
			targetPart.Color = state.Color
			targetPart.Material = state.Material
			targetPart.CanCollide = state.CanCollide
		end
	end
	table.clear(originalPartStates)
end

local function applyHitbox(plr)
	if plr == LocalPlayer or not hitboxEnabled then return end
	local char = plr.Character
	if not char then return end

	local targetPart = getTargetPart(char)
	if targetPart then
		if not originalPartStates[targetPart] then
			originalPartStates[targetPart] = {
				Size = targetPart.Size,
				Transparency = targetPart.Transparency,
				Color = targetPart.Color,
				Material = targetPart.Material,
				CanCollide = targetPart.CanCollide
			}
		end

		targetPart.Size = Vector3.new(currentHitboxSize, currentHitboxSize, currentHitboxSize)
		targetPart.Transparency = currentHitboxTransparency
		targetPart.Color = Color3.fromRGB(255, 0, 0)
		targetPart.Material = Enum.Material.SmoothPlastic
		targetPart.CanCollide = false
	end
end

-- ESP Drawing Setup
local function setupPlayerESP(plr)
	if espBoxes[plr] then return end
	local box = Drawing.new("Square")
	box.Visible = false
	box.Color = Color3.fromRGB(255, 255, 255)
	box.Thickness = 1.5
	box.Transparency = 1
	box.Filled = false
	espBoxes[plr] = box
end

local function removePlayerESP(plr)
	if espBoxes[plr] then
		espBoxes[plr]:Remove()
		espBoxes[plr] = nil
	end
end

for _, plr in ipairs(Players:GetPlayers()) do
	if plr ~= LocalPlayer then
		setupPlayerESP(plr)
	end
end

table.insert(connections, Players.PlayerAdded:Connect(function(plr)
	if plr ~= LocalPlayer then
		setupPlayerESP(plr)
	end
end))

table.insert(connections, Players.PlayerRemoving:Connect(function(plr)
	removePlayerESP(plr)
	if plr == camlockTarget then
		camlockTarget = nil
	end
	resetHitbox(plr)
end))

-- Kill Switch
local function executeKillSwitch()
	hitboxEnabled = false
	camlockEnabled = false
	camlockTarget = nil
	espBoxEnabled = nil
	
	if fogEnabled then
		fogEnabled = false
		Lighting.FogStart = originalFogStart
		Lighting.FogEnd = originalFogEnd
		Lighting.FogColor = originalFogColor
	end
	
	resetAllHitboxes()
	restoreAllBlood()

	for plr, box in pairs(espBoxes) do
		box:Remove()
	end
	table.clear(espBoxes)

	for _, conn in ipairs(connections) do
		if conn and typeof(conn) == "RBXScriptConnection" and conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(connections)

	if screenGui then
		screenGui:Destroy()
	end
end

