-- ESP DRAWING POOL
local ESP_Cache = {}
local MAX_DISTANCE = 250

local R15Joints = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"}, {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"}, {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}
}
local R6Joints = {
    {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"}, {"Torso", "Left Leg"}, {"Torso", "Right Leg"}
}

local function createPlayerESP(player)
    if player == LocalPlayer or ESP_Cache[player] then return end

    local outline = Drawing.new("Square")
    outline.Thickness = 1
    outline.Filled = true
    outline.Color = Color3.fromRGB(0, 0, 0)
    outline.Visible = false

    local fill = Drawing.new("Square")
    fill.Thickness = 1
    fill.Filled = true
    fill.Color = Color3.fromRGB(0, 255, 0)
    fill.Visible = false

    local nameTag = Drawing.new("Text")
    nameTag.Size = 13
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.OutlineColor = Color3.fromRGB(0, 0, 0)
    nameTag.Color = Color3.fromRGB(255, 255, 255)
    nameTag.Visible = false

    local lines = {}
    for i = 1, 10 do
        local line = Drawing.new("Line")
        line.Thickness = 1
        line.Color = Color3.fromRGB(255, 255, 255)
        line.Visible = false
        table.insert(lines, line)
    end

    ESP_Cache[player] = {
        Outline = outline,
        Fill = fill,
        Name = nameTag,
        Lines = lines
    }
end

local function removePlayerESP(player)
    if ESP_Cache[player] then
        ESP_Cache[player].Outline:Remove()
        ESP_Cache[player].Fill:Remove()
        ESP_Cache[player].Name:Remove()
        for _, line in ipairs(ESP_Cache[player].Lines) do line:Remove() end
        ESP_Cache[player] = nil
    end
end

for _, p in pairs(Players:GetPlayers()) do createPlayerESP(p) end
Players.PlayerAdded:Connect(createPlayerESP)
Players.PlayerRemoving:Connect(removePlayerESP)

-- Fast Render Loop
RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    for player, data in pairs(ESP_Cache) do
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")

        if char and hum and hrp and hum.Health > 0 then
            local distance = (myHRP.Position - hrp.Position).Magnitude

            if distance <= MAX_DISTANCE then
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                if onScreen then
                    -- 1. HEALTHBAR
                    if ESP_Health_Enabled then
                        local headPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vector
                        local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        local height = math.abs(headPos.Y - legPos.Y)
                        local width = height / 2
                        local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)

                        local barWidth = 2
                        local barX = vector.X - (width / 2) - 5
                        local barY = vector.Y - (height / 2)

                        data.Outline.Position = Vector2.new(barX, barY)
                        data.Outline.Size = Vector2.new(barWidth, height)
                        data.Outline.Visible = true

                        local fillHeight = height * pct
                        data.Fill.Position = Vector2.new(barX, barY + (height - fillHeight))
                        data.Fill.Size = Vector2.new(barWidth, fillHeight)
                        data.Fill.Color = Color3.fromRGB(255 * (1 - pct), 255 * pct, 0)
                        data.Fill.Visible = true
                    else
                        data.Outline.Visible = false
                        data.Fill.Visible = false
                    end

                    -- 2. DISPLAY NAME
                    if ESP_Name_Enabled and head then
                        local hPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.2, 0))
                        data.Name.Text = player.DisplayName
                        data.Name.Position = Vector2.new(hPos.X, hPos.Y)
                        data.Name.Visible = true
                    else
                        data.Name.Visible = false
                    end

                    -- 3. BONES
                    if ESP_Bone_Enabled then
                        local joints = (hum.RigType == Enum.HumanoidRigType.R15) and R15Joints or R6Joints
                        for idx, line in ipairs(data.Lines) do
                            if idx <= #joints then
                                local pA = char:FindFirstChild(joints[idx][1])
                                local pB = char:FindFirstChild(joints[idx][2])
                                if pA and pB then
                                    local posA, vA = Camera:WorldToViewportPoint(pA.Position)
                                    local posB, vB = Camera:WorldToViewportPoint(pB.Position)
                                    if vA and vB then
                                        line.From = Vector2.new(posA.X, posA.Y)
                                        line.To = Vector2.new(posB.X, posB.Y)
                                        line.Visible = true
                                    else line.Visible = false end
                                else line.Visible = false end
                            else line.Visible = false end
                        end
                    else
                        for _, l in ipairs(data.Lines) do l.Visible = false end
                    end
                else
                    data.Outline.Visible = false
                    data.Fill.Visible = false
                    data.Name.Visible = false
                    for _, l in ipairs(data.Lines) do l.Visible = false end
                end
            else
                data.Outline.Visible = false
                data.Fill.Visible = false
                data.Name.Visible = false
                for _, l in ipairs(data.Lines) do l.Visible = false end
            end
        else
            data.Outline.Visible = false
            data.Fill.Visible = false
            data.Name.Visible = false
            for _, l in ipairs(data.Lines) do l.Visible = false end
        end
    end
end)

