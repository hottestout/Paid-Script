local ESP_Health_Enabled = false
local ESP_Name_Enabled = false
local ESP_Bone_Enabled = false

-- ONE-TIME GUI HOOK (Runs once on inject so it never drops FPS)
local function hookMenuButton(targetText, onStateChanged)
    task.spawn(function()
        task.wait(0.5) -- Short delay to ensure GUI is rendered
        local containers = {CoreGui, LocalPlayer:FindFirstChild("PlayerGui")}
        
        for _, gui in ipairs(containers) do
            if gui then
                for _, obj in ipairs(gui:GetDescendants()) do
                    if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Text == targetText then
                        local row = obj.Parent
                        if row then
                            local function updateState()
                                local isON = false
                                for _, child in ipairs(row:GetDescendants()) do
                                    if (child:IsA("TextLabel") or child:IsA("TextButton")) and child.Text == "ON" then
                                        isON = true
                                        break
                                    end
                                    if child:IsA("GuiObject") and child.BackgroundColor3.G > 0.5 and child.BackgroundColor3.R < 0.5 then
                                        isON = true
                                        break
                                    end
                                end
                                onStateChanged(isON)
                            end

                            -- Set initial state
                            updateState()

                            -- Event connections for instant update on click (No loops!)
                            for _, child in ipairs(row:GetDescendants()) do
                                if child:IsA("TextButton") then
                                    child.MouseButton1Click:Connect(function()
                                        task.defer(updateState)
                                    end)
                                elseif child:IsA("TextLabel") then
                                    child:GetPropertyChangedSignal("Text"):Connect(updateState)
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end

