-- RenderStepped Loop for Hitbox, Camlock, Visual ESP & Box Drawing tracking
table.insert(connections, RunService.RenderStepped:Connect(function()
	if hitboxEnabled then
		local targetSize = Vector3.new(currentHitboxSize, currentHitboxSize, currentHitboxSize)
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				local targetPart = getTargetPart(plr.Character)
				if targetPart then
					if targetPart.Size ~= targetSize or targetPart.Transparency ~= currentHitboxTransparency then
						applyHitbox(plr)
					end
				end
			end
		end
	end

	if camlockEnabled then
		if not camlockTarget or not camlockTarget.Character or not camlockTarget.Character:FindFirstChildOfClass("Humanoid") or camlockTarget.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then
			camlockTarget = getClosestPlayerToCursor()
		end

		if camlockTarget and camlockTarget.Character then
			local targetPart = getTargetPart(camlockTarget.Character)
			if targetPart then
				local basePredictedPos = targetPart.Position + (targetPart.AssemblyLinearVelocity * camlockPrediction)
				local horizontalOffset = Camera.CFrame.RightVector * camlockOffsetX
				local verticalOffset = Camera.CFrame.UpVector * camlockOffsetY
				local finalTargetPos = basePredictedPos + horizontalOffset + verticalOffset

				local targetCFrame = CFrame.new(Camera.CFrame.Position, finalTargetPos)
				Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, camlockSmoothness)
			end
		end
	end

	-- ESP Box Drawing Loop
	for plr, box in pairs(espBoxes) do
		local char = plr.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		local head = char and char:FindFirstChild("Head")

		if espBoxEnabled and char and hrp and humanoid and humanoid.Health > 0 then
			local headPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
			local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.5, 0))
			local rootPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

			if onScreen then
				local height = math.abs(headPos.Y - legPos.Y)
				local width = height / 1.5

				box.Size = Vector2.new(width, height)
				box.Position = Vector2.new(rootPos.X - width / 2, rootPos.Y - height / 2)
				box.Visible = true
			else
				box.Visible = false
			end
		else
			box.Visible = false
		end
	end
end))

-- UI Dragging (Ignores dragging if clicking inside dropdown elements)
local dragging = false
local dragInput, dragStart, startPos

local function updateDrag(input)
	local delta = input.Position - dragStart
	local targetPos = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
	TweenService:Create(mainFrame, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()
end

table.insert(connections, mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local dropFrame = mainFrame:FindFirstChild("DropdownMenu", true)
		if dropFrame and dropFrame.Visible then
			local mousePos = input.Position
			local absPos = dropFrame.AbsolutePosition
			local absSize = dropFrame.AbsoluteSize
			if mousePos.X >= absPos.X and mousePos.X <= absPos.X + absSize.X and
			   mousePos.Y >= absPos.Y and mousePos.Y <= absPos.Y + absSize.Y then
				return
			end
		end

		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position

		local endConn
		endConn = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				endConn:Disconnect()
			end
		end)
	end
end))

