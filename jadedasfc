-- Toggle UI visibility using F4 Key
local isVisible = true
local isAnimating = false
local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function toggleUI()
	if isAnimating then return end
	isAnimating = true
	isVisible = not isVisible

	if isVisible then
		mainFrame.Visible = true
		mainFrame.GroupTransparency = 1
		local tween = TweenService:Create(mainFrame, tweenInfo, {GroupTransparency = 0})
		tween:Play()
		tween.Completed:Connect(function()
			isAnimating = false
		end)
	else
		local tween = TweenService:Create(mainFrame, tweenInfo, {GroupTransparency = 1})
		tween:Play()
		tween.Completed:Connect(function()
			if not isVisible then
				mainFrame.Visible = false
			end
			isAnimating = false
		end)
	end
end

table.insert(connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.KeyCode == Enum.KeyCode.F4 then
		toggleUI()
	end
end))

-- ULTRA-LIGHTWEIGHT ESP WITH ZERO-LAG GUI HOOK (Paste at Line 1860)
local RunService = game:GetService("RunService")
